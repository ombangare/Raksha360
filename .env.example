# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# Raksha360 local development backend and dashboard credentials. Change these before sharing the server.
RAKSHA360_DEVICE_TOKEN=local-dev-device-token-change-me
RAKSHA360_DASHBOARD_TOKEN=local-dev-dashboard-token-change-me
RAKSHA360_DATABASE_PATH=backend/data/raksha360.sqlite3
RAKSHA360_SEED_DEMO_DATA=true
RAKSHA360_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Phone-off / missed-heartbeat monitor. Set these in the root .env after first startup.
# The backend can email only the last location previously received; a powered-off phone cannot send new GPS.
RAKSHA360_OFFLINE_THRESHOLD_SECONDS=180
RAKSHA360_OFFLINE_MONITOR_INTERVAL_SECONDS=30
RAKSHA360_OFFLINE_EMAIL_RETRY_SECONDS=900

# Optional SMTP email delivery for explicitly consented emergency contacts.
# Leave the host/from blank to keep email delivery disabled and accurately marked as NOT_CONFIGURED.
# For most submission servers, use TLS on port 587 and an app password/provider SMTP credential.
RAKSHA360_SMTP_HOST=
RAKSHA360_SMTP_PORT=587
RAKSHA360_SMTP_USERNAME=
RAKSHA360_SMTP_PASSWORD=
RAKSHA360_SMTP_FROM_EMAIL=
RAKSHA360_SMTP_USE_TLS=true
